<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>

		<TargetFramework>netstandard2.1</TargetFramework>

		<PackageId>BigRedProf.Data.Tape</PackageId>
		<IsPackable>true</IsPackable>

		<Title>Data Tape Library</Title>
		<Description>Tape storage for BigRedProf codes: append-only frames on a tape, and the readers and writers that move over them.</Description>
		<PackageTags>bigredprof;tape;storage;append-only;backup</PackageTags>

		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>

	</PropertyGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Core\BigRedProf.Data.Core.csproj" />
	</ItemGroup>

</Project>
