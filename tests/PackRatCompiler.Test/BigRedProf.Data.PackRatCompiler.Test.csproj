<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="_Resources\ExpectedPackRats\ListTestModelPackRat.cs" />
    <Compile Remove="_Resources\ExpectedPackRats\MixedListTestModelPackRat.cs" />
    <Compile Remove="_Resources\ExpectedPackRats\ModelWithEnumPackRat.cs" />
    <Compile Remove="_Resources\ExpectedPackRats\NullableTestModelPackRat.cs" />
    <Compile Remove="_Resources\ExpectedPackRats\PointPackRat.cs" />
    <Compile Remove="_Resources\ExpectedPackRats\TokenTestModelPackRat.cs" />
    <Compile Remove="_Resources\Models\ListTestModel.cs" />
    <Compile Remove="_Resources\Models\MixedListTestModel.cs" />
    <Compile Remove="_Resources\Models\ModelWithEnum.cs" />
    <Compile Remove="_Resources\Models\NullableTestModel.cs" />
    <Compile Remove="_Resources\Models\Point.cs" />
    <Compile Remove="_Resources\Models\GappedFieldPositionTestModel.cs" />
    <Compile Remove="_Resources\Models\TokenTestModel.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="_Resources\ExpectedPackRats\ListTestModelPackRat.cs" />
    <EmbeddedResource Include="_Resources\ExpectedPackRats\MixedListTestModelPackRat.cs" />
    <EmbeddedResource Include="_Resources\ExpectedPackRats\NullableTestModelPackRat.cs" />
    <EmbeddedResource Include="_Resources\ExpectedPackRats\ModelWithEnumPackRat.cs" />
    <EmbeddedResource Include="_Resources\ExpectedPackRats\TokenTestModelPackRat.cs" />
    <EmbeddedResource Include="_Resources\ExpectedPackRats\PointPackRat.cs" />
    <EmbeddedResource Include="_Resources\Models\ListTestModel.cs" />
    <EmbeddedResource Include="_Resources\Models\MixedListTestModel.cs" />
    <EmbeddedResource Include="_Resources\Models\ModelWithEnum.cs" />
    <EmbeddedResource Include="_Resources\Models\Point.cs" />
    <EmbeddedResource Include="_Resources\Models\GappedFieldPositionTestModel.cs" />
    <EmbeddedResource Include="_Resources\Models\NullableTestModel.cs" />
    <EmbeddedResource Include="_Resources\Models\TokenTestModel.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis" Version="4.11.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.1.0" />
    <PackageReference Include="xunit" Version="2.4.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.3">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="3.1.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!--
      These tests open BigRedProf.Data.Core as a real MSBuild project, so they need its .csproj
      path at runtime. Resolving it by walking up from AppContext.BaseDirectory means counting
      the bin/<configuration>/<framework> levels, which is a property of the build rather than
      of the repository; adding a target framework or redirecting output silently breaks it.
      MSBuild already knows where this project sits, so it resolves the path at build time and
      hands it over as assembly metadata.
    -->
    <AssemblyMetadata Include="CoreProjectPath"
                      Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\src\Core\BigRedProf.Data.Core.csproj'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PackRatCompiler\BigRedProf.Data.PackRatCompiler.csproj" />
  </ItemGroup>

</Project>
